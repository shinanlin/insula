Bootstrap: docker
From: ubuntu:22.04

# MAPER toolchain container: MIRTK + NiftySeg + MAPER scripts (built from source)
#
# NOTE ubuntu version: apptainer's fakeroot shim ("faked") requires glibc
# >=2.33/2.34. ubuntu:20.04 ships glibc 2.31 and fails the unprivileged
# fakeroot build; ubuntu:22.04 (glibc 2.35) works and MIRTK/NiftySeg both
# compile cleanly on it. Do not downgrade the base image without re-testing
# fakeroot support on the target cluster.

%post
    set -e
    # Fix apt setgroups failure in unprivileged (root-mapped) apptainer build
    echo 'APT::Sandbox::User "root";' > /etc/apt/apt.conf.d/00sandbox-off
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends \
        build-essential cmake git wget curl ca-certificates python3 python3-dev python-is-python3 \
        zlib1g-dev libboost-all-dev libeigen3-dev libtbb-dev \
        libpng-dev libflann-dev \
        bc findutils tar gzip sed grep coreutils util-linux
    rm -rf /var/lib/apt/lists/*

    mkdir -p /opt/src
    echo "MAPER toolchain container build" > /opt/BUILD_INFO.txt
    echo "build date: $(date -u)" >> /opt/BUILD_INFO.txt
    echo "base: ubuntu:22.04  gcc: $(gcc -dumpversion)" >> /opt/BUILD_INFO.txt

    # ---------- MIRTK ----------
    cd /opt/src
    git clone --recursive https://github.com/BioMedIA/MIRTK.git
    cd MIRTK
    echo "MIRTK commit: $(git rev-parse HEAD)" >> /opt/BUILD_INFO.txt
    mkdir build && cd build
    cmake -D CMAKE_INSTALL_PREFIX=/opt/mirtk \
          -D CMAKE_BUILD_TYPE=Release \
          -D BUILD_APPLICATIONS=ON \
          -D PYTHON_EXECUTABLE=/usr/bin/python3 \
          -D DEPENDS_PythonInterp_DIR=/usr/bin \
          -D WITH_TBB=ON \
          -D MODULE_Deformable=OFF \
          -D MODULE_Registration=ON \
          -D MODULE_PointSet=OFF \
          -D MODULE_Transformation=ON \
          ..
    make -j"$(nproc)"
    make install

    # ---------- NiftySeg ----------
    cd /opt/src
    git clone https://github.com/KCL-BMEIS/NiftySeg.git
    cd NiftySeg
    echo "NiftySeg commit: $(git rev-parse HEAD)" >> /opt/BUILD_INFO.txt
    mkdir build && cd build
    cmake -D CMAKE_INSTALL_PREFIX=/opt/niftyseg \
          -D CMAKE_BUILD_TYPE=Release \
          -D USE_OPENMP=ON \
          -D INSTALL_NIFTYREG=OFF \
          ..
    make -j"$(nproc)"
    make install

    # ---------- MAPER scripts ----------
    git clone https://github.com/soundray/maper.git /opt/maper
    echo "MAPER commit: $(cd /opt/maper && git rev-parse HEAD)" >> /opt/BUILD_INFO.txt
    chmod +x /opt/maper/maper /opt/maper/launchlist-gen \
             /opt/maper/run-maper-example-generate.sh \
             /opt/maper/hammers_mith-ancillaries.sh 2>/dev/null || true

    rm -rf /opt/src

%environment
    export PATH=/opt/maper:/opt/mirtk/bin:/opt/niftyseg/bin:$PATH
    export LC_ALL=C

%runscript
    exec "$@"

%test
    export PATH=/opt/maper:/opt/mirtk/bin:/opt/niftyseg/bin:$PATH
    echo "=== BUILD_INFO ==="; cat /opt/BUILD_INFO.txt
    echo "=== mirtk ==="; which mirtk && mirtk --version 2>&1 | head -2
    echo "=== seg_maths ==="; which seg_maths
    echo "=== maper ==="; which maper
    echo "=== mirtk apps ==="; mirtk help 2>&1 | grep -iE 'register|transform-image|calculate-element|evaluate-label' | head
